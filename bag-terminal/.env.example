# ============================================================
# 挎包终端环境变量配置模板
# 复制为 .env 并修改各项配置
# ============================================================

# ── 通用 ──
ENVIRONMENT=production                    # development / staging / production
DEBUG=false
LOG_LEVEL=info                            # debug / info / warning / error

# ── SaaS 后端 API ──
SAAS_API_URL=https://saas.railway-inspection.com/api/v1
SAAS_API_USERNAME=glasses-terminal
SAAS_API_PASSWORD=CHANGE_ME
SAAS_API_TENANT_CODE=crcc-demo
SAAS_API_TIMEOUT=30
SAAS_API_TOKEN_TTL_BUFFER=300

# ── 涂鸦 IoT 云 ──
TUYA_ENABLED=true                        # 是否启用涂鸦（false 则纯 BLE+REST）
TUYA_ACCESS_ID=CHANGE_ME                 # 涂鸦云 Access ID
TUYA_ACCESS_KEY=CHANGE_ME                # 涂鸦云 Access Secret
TUYA_GATEWAY_ID=CHANGE_ME                # 网关设备 ID
TUYA_GATEWAY_UUID=CHANGE_ME              # 网关 UUID
TUYA_GATEWAY_KEY=CHANGE_ME               # 网关密钥
TUYA_MQTT_BROKER=m1.tuyacn.com           # MQTT broker 地址
TUYA_MQTT_PORT=8883                      # MQTT 端口
TUYA_MQTT_QOS=1                          # MQTT QoS
TUYA_SDK_PATH=/usr/local/lib/libtuya_iot_gateway.so  # SDK 库路径

# ── BLE 配置 ──
BLE_SCAN_DURATION=10                     # BLE 扫描时长（秒）
BLE_SCAN_INTERVAL=30                     # 重新扫描间隔（秒）
BLE_MAX_CONNECTIONS=4                    # 最多同时连接的眼镜数
BLE_RECONNECT_INTERVAL=5                 # 重连间隔（秒）
BLE_NUS_SERVICE_UUID=6e400001-b5a3-f393-e0a9-e50e24dcca9e
BLE_NUS_RX_CHAR_UUID=6e400002-b5a3-f393-e0a9-e50e24dcca9e
BLE_NUS_TX_CHAR_UUID=6e400003-b5a3-f393-e0a9-e50e24dcca9e

# ── AI 模型 ──
MODEL_DIR=/mnt/sdcard/bag-terminal/models
YOLO_MODEL_PATH=/mnt/sdcard/bag-terminal/models/yolov8n_railway.onnx
YOLO_MODEL_VERSION=1.0.0
YOLO_INPUT_SIZE=320                      # YOLO 输入分辨率
YOLO_CONF_THRESHOLD=0.5                  # 置信度阈值
YOLO_NMS_THRESHOLD=0.4                   # NMS 阈值
EMBEDDING_MODEL_PATH=/mnt/sdcard/bag-terminal/models/bge-small-zh.onnx
EMBEDDING_DIMENSION=512
LLM_MODEL_PATH=/mnt/sdcard/bag-terminal/models/phi-3-mini-q4.gguf
LLM_MAX_TOKENS=512                       # 最大生成 Token 数
LLM_CONTEXT_SIZE=4096

# ── RAG 引擎 ──
RAG_VECTOR_STORE_PATH=/data/bag-terminal/qdrant  # Qdrant 本地存储
RAG_COLLECTION_NAME=railway_knowledge
RAG_EMBEDDING_DIM=512
RAG_TOP_K=5                             # 检索 Top-K 文档
RAG_FALLBACK_TO_SAAS=true               # 本地 RAG 失败时回退 SaaS

# ── 本地存储 ──
DB_PATH=/data/bag-terminal/local.db       # SQLite 数据库路径
STORAGE_ROOT=/mnt/sdcard/bag-terminal     # SD 卡存储根目录
PHOTOS_DIR=photos
VIDEOS_DIR=videos
ALERTS_DIR=alerts
MAX_RETENTION_DAYS=30                     # 本地数据最大保留天数
DISK_FULL_THRESHOLD=0.95                  # 磁盘使用率告警阈值
DISK_CLEANUP_THRESHOLD=0.85               # 触发清理的阈值

# ── 离线同步 ──
SYNC_BATCH_SIZE=50                        # 每批同步数量
SYNC_MAX_CONCURRENT=5                     # 并发同步数
SYNC_RETRY_BASE_DELAY=1.0                 # 初始重试间隔（秒）
SYNC_RETRY_MAX_DELAY=300                  # 最大重试间隔（秒）
SYNC_INTERVAL=30                          # 定期同步间隔（秒）

# ── 5G 模块（Quectel RM500Q-GL）──
MODEM_SERIAL_PORT=/dev/ttyUSB2            # 串口设备
MODEM_BAUDRATE=115200                     # 波特率
MODEM_APN=cmnet                           # APN（移动/联通/电信）
MODEM_NETWORK_PREF=5G                     # 5G / LTE_AUTO / auto
MODEM_AT_TIMEOUT=10                       # AT 命令超时（秒）
MODEM_DIAL_MODE=ecm                       # ecm / ppp

# ── 网络监控 ──
NETWORK_CHECK_INTERVAL=30                # 连通性检测间隔（秒）
NETWORK_RECONNECT_INTERVAL=10            # 重连初始间隔（秒）
NETWORK_PROBE_URL=http://www.baidu.com   # 探测 URL
WIFI_INTERFACE=wlan0                      # WiFi 接口名
MODEM_INTERFACE=usb0                      # 5G 网络接口名

# ── 充电管理（BQ25895）──
CHARGE_I2C_BUS=1                          # I2C 总线号
CHARGE_I2C_DEVICE=/dev/i2c-1             # I2C 设备路径
CHARGE_VOLTAGE_MV=4208                    # 充电截止电压 mV
CHARGE_CURRENT_MA=2000                    # 充电电流 mA
CHARGE_TEMP_SHUTDOWN_C=60                 # 温度关断阈值 ℃
CHARGE_MONITOR_INTERVAL=10               # 充电监控间隔（秒）

# ── OTA ──
OTA_CHUNK_SIZE=512                        # BLE 分块大小
OTA_CHUNK_TIMEOUT=10                      # 块超时（秒）
OTA_MAX_CHUNK_RETRIES=3                   # 最大块重试次数
OTA_DOWNLOAD_DIR=/tmp/firmware            # 固件下载临时目录
OTA_VERIFY_TIMEOUT=120                    # 重启验证超时（秒）

# ── Prometheus 监控 ──
METRICS_ENABLED=true                     # 是否启用 Prometheus 指标
METRICS_COLLECT_INTERVAL=15              # 指标采集间隔（秒）

# ── MinIO 对象存储 ──
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=railway-models               # 模型桶
MINIO_PHOTOS_BUCKET=railway-photos       # 照片桶

# ── 安全 ──
SECRET_KEY=CHANGE_ME                      # JWT 密钥（openssl rand -hex 32 生成）
JWT_ALGORITHM=HS256
JWT_TOKEN_EXPIRE_MINUTES=1440             # Token 有效期 24 小时
